{
  "name": "@toursnap/server-memory",
  "version": "0.7.0",
  "description": "MCP server for enabling memory for Claude through a knowledge graph",
  "license": "MIT",
  "author": "bilbo",
  "homepage": "https://modelcontextprotocol.io",
  "bugs": "https://github.com/modelcontextprotocol/servers/issues",
  "type": "module",
  "bin": {
    "mcp-server-memory": "dist/index.js"
  },
  "files": [
    "dist",
    "test"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "test/run-tests.sh",
    "test:supabase": "node test/test-supabase.js",
    "test:supabase:semantic": "node test/test-supabase-semantic.js",
    "test:api": "node test/test-memory-api.js",
    "test:embedding": "test/run-embedding-tests.sh",
    "test:semantic": "test/run-semantic-search-tests.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.0.1",
    "@supabase/supabase-js": "2.39.3",
    "dotenv": "^16.5.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/node-fetch": "^2.6.12",
    "shx": "^0.3.4",
    "typescript": "^5.6.2"
  }
}
